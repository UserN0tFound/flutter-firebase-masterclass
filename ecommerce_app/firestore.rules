rules_version = '2'; // Spécifie la version des règles Firestore
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour la collection 'products'
    match /products/{id} {
      // Autorise la lecture de tous les documents dans la collection 'products'
      allow read: if true;
      // Autorise l'écriture dans la collection 'products' uniquement si l'utilisateur est authentifié et a le rôle d'administrateur
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Règles pour la collection 'metadata', utilisée par UserMetadataRepository
    match /metadata/{uid} {
      // Autorise la lecture des documents dans la collection 'metadata' uniquement si l'utilisateur authentifié correspond à l'UID du document
      allow read: if request.auth.uid == uid;
    }
    // Règles pour la collection 'cart'
    match /cart/{uid} {
      // Autorise la lecture et l'écriture des documents dans la collection 'cart' uniquement si l'utilisateur authentifié correspond à l'UID du document
      allow read, write: if request.auth.uid == uid;
    }
  }
}